# Backend (prototype — no real secrets required for local demo)
SECRET_KEY=change-me-in-production
DATABASE_URL=sqlite:///./data/app.db
CORS_ORIGINS=http://localhost:5173
# Must align with worker output dir (PPTX files)
QUOTATION_OUTPUT_DIR=./worker/output

# Worker (local process = mock execution device / Mac mini)
BACKEND_URL=http://127.0.0.1:8000
WORKER_POLL_INTERVAL=3

# Optional AI note normalization (note is NOT filled onto PPTX V2 slide)
USE_CODEX_CLI=false
AI_NOTE_ENABLED=true
AI_FAIL_JOB_ON_ERROR=false
